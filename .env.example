# Скопировать в deploy/compose/.env, если нужно поменять значения по умолчанию.
# Секретов здесь нет и не должно быть.

# Имя сайта для сертификата Caddy. Ноутбук: localhost. Pi: discipline.home.arpa.
SITE_ADDRESS=localhost
# На каком адресе и порту слушать HTTPS снаружи контейнера.
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
LOG_LEVEL=INFO
